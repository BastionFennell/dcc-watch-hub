{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dcc-watch-hub/contracts/episode.v5.schema.json",
  "title": "EpisodeData (008 real crawlers, revision 2)",
  "type": "object",
  "required": [
    "episodeId",
    "initialState",
    "events"
  ],
  "additionalProperties": false,
  "definitions": {
    "cell": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "namedEntry": {
      "comment": "008 revision 2: a Hotlist mark or a carried item. A plain string is the v1 shorthand for { name }.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "qty": {
              "type": "integer",
              "minimum": 0
            },
            "desc": {
              "type": "string"
            },
            "ref": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          },
          "anyOf": [
            {
              "required": [
                "name"
              ]
            },
            {
              "required": [
                "ref"
              ]
            }
          ],
          "comment": "008 revision 4: `ref` points at a SpellDef id; an entry needs a name or a ref."
        }
      ]
    },
    "entryList": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/namedEntry"
      }
    },
    "crawler": {
      "type": "object",
      "required": [
        "id",
        "name",
        "handle",
        "player",
        "level",
        "hp",
        "portrait",
        "class",
        "inventory",
        "rank"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "handle": {
          "type": "string"
        },
        "player": {
          "type": "string"
        },
        "level": {
          "type": "integer",
          "minimum": 1
        },
        "hp": {
          "type": "object",
          "required": [
            "current",
            "max"
          ],
          "additionalProperties": false,
          "properties": {
            "current": {
              "type": "number",
              "minimum": 0
            },
            "max": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "portrait": {
          "type": "string"
        },
        "class": {
          "type": [
            "string",
            "null"
          ]
        },
        "inventory": {
          "$ref": "#/definitions/entryList"
        },
        "rank": {
          "type": [
            "integer",
            "null"
          ]
        },
        "race": {
          "type": "string"
        },
        "pronouns": {
          "type": "string"
        },
        "crawlerNumber": {
          "type": [
            "string",
            "integer"
          ]
        },
        "stats": {
          "type": "object",
          "required": [
            "str",
            "int",
            "con",
            "dex",
            "cha"
          ],
          "additionalProperties": false,
          "properties": {
            "str": {
              "type": "number"
            },
            "int": {
              "type": "number"
            },
            "con": {
              "type": "number"
            },
            "dex": {
              "type": "number"
            },
            "cha": {
              "type": "number"
            }
          }
        },
        "hotlist": {
          "$ref": "#/definitions/entryList"
        },
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/skillEntry"
          }
        },
        "spells": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/spellEntry"
          }
        },
        "gear": {
          "$ref": "#/definitions/gear"
        },
        "art": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "baseEvent": {
      "type": "object",
      "required": [
        "t",
        "type"
      ],
      "properties": {
        "t": {
          "type": "number",
          "minimum": 0
        },
        "type": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        }
      }
    },
    "skillEntry": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "rank": {
          "type": "integer",
          "minimum": 0
        },
        "desc": {
          "type": "string"
        }
      }
    },
    "spellEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "rank": {
          "type": "integer",
          "minimum": 0
        },
        "mana": {
          "type": "integer",
          "minimum": 0
        },
        "desc": {
          "type": "string"
        },
        "ref": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        }
      },
      "anyOf": [
        {
          "required": [
            "name"
          ]
        },
        {
          "required": [
            "ref"
          ]
        }
      ],
      "comment": "008 revision 4: `ref` inherits name, mana and text from the spell registry; `mana` and `desc` override it."
    },
    "gearSlot": {
      "enum": [
        "head",
        "torso",
        "arms",
        "hands",
        "legs",
        "feet",
        "accessory"
      ]
    },
    "gear": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "head": {
          "type": "string",
          "minLength": 1
        },
        "torso": {
          "type": "string",
          "minLength": 1
        },
        "arms": {
          "type": "string",
          "minLength": 1
        },
        "hands": {
          "type": "string",
          "minLength": 1
        },
        "legs": {
          "type": "string",
          "minLength": 1
        },
        "feet": {
          "type": "string",
          "minLength": 1
        },
        "accessories": {
          "$ref": "#/definitions/stringList"
        }
      }
    },
    "npcAction": {
      "enum": [
        "met",
        "seen",
        "update",
        "defeated"
      ]
    }
  },
  "properties": {
    "episodeId": {
      "type": "integer",
      "minimum": 1
    },
    "initialState": {
      "type": "object",
      "required": [
        "party",
        "map"
      ],
      "additionalProperties": false,
      "properties": {
        "party": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/crawler"
          },
          "minItems": 1
        },
        "map": {
          "type": "object",
          "required": [
            "floor",
            "grid",
            "revealed"
          ],
          "additionalProperties": false,
          "properties": {
            "floor": {
              "type": "integer",
              "minimum": 1
            },
            "grid": {
              "type": "object",
              "required": [
                "cols",
                "rows"
              ],
              "additionalProperties": false,
              "properties": {
                "cols": {
                  "type": "integer",
                  "minimum": 1
                },
                "rows": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "revealed": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/cell"
              }
            }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/definitions/baseEvent"
          },
          {
            "oneOf": [
              {
                "properties": {
                  "type": {
                    "const": "system_message"
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "text"
                ]
              },
              {
                "properties": {
                  "type": {
                    "const": "achievement"
                  },
                  "title": {
                    "type": "string"
                  },
                  "desc": {
                    "type": "string"
                  }
                },
                "required": [
                  "actor",
                  "title"
                ]
              },
              {
                "properties": {
                  "type": {
                    "const": "loot"
                  },
                  "item": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string"
                  }
                },
                "required": [
                  "actor",
                  "item"
                ]
              },
              {
                "properties": {
                  "type": {
                    "const": "hp"
                  },
                  "current": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  }
                },
                "required": [
                  "actor",
                  "current",
                  "max"
                ]
              },
              {
                "properties": {
                  "type": {
                    "const": "level_up"
                  },
                  "level": {
                    "type": "integer"
                  }
                },
                "required": [
                  "actor",
                  "level"
                ]
              },
              {
                "properties": {
                  "type": {
                    "const": "rank"
                  },
                  "actor": {
                    "type": "string",
                    "minLength": 1
                  },
                  "rank": {
                    "type": "integer"
                  }
                },
                "required": [
                  "actor",
                  "rank"
                ]
              },
              {
                "properties": {
                  "type": {
                    "const": "map_reveal"
                  },
                  "cells": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/cell"
                    }
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "required": [
                  "cells"
                ]
              },
              {
                "properties": {
                  "type": {
                    "const": "sponsor"
                  },
                  "text": {
                    "type": "string"
                  },
                  "durationSec": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "text",
                  "durationSec"
                ]
              },
              {
                "properties": {
                  "type": {
                    "const": "chapter"
                  },
                  "label": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string"
                  }
                },
                "required": [
                  "label",
                  "kind"
                ]
              },
              {
                "properties": {
                  "type": {
                    "const": "status"
                  },
                  "add": {
                    "$ref": "#/definitions/stringList"
                  },
                  "remove": {
                    "$ref": "#/definitions/stringList"
                  }
                },
                "required": [
                  "actor",
                  "add",
                  "remove"
                ]
              },
              {
                "properties": {
                  "type": {
                    "const": "inventory"
                  },
                  "add": {
                    "$ref": "#/definitions/stringList"
                  },
                  "remove": {
                    "$ref": "#/definitions/stringList"
                  }
                },
                "required": [
                  "actor",
                  "add",
                  "remove"
                ]
              },
              {
                "properties": {
                  "type": {
                    "const": "note"
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "text"
                ]
              },
              {
                "properties": {
                  "type": {
                    "const": "skill"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "rank": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "desc": {
                    "type": "string"
                  }
                },
                "required": [
                  "actor",
                  "name"
                ]
              },
              {
                "properties": {
                  "type": {
                    "const": "spell"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "rank": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "mana": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "desc": {
                    "type": "string"
                  },
                  "ref": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]+$"
                  }
                },
                "required": [
                  "actor"
                ],
                "anyOf": [
                  {
                    "required": [
                      "name"
                    ]
                  },
                  {
                    "required": [
                      "ref"
                    ]
                  }
                ]
              },
              {
                "properties": {
                  "type": {
                    "const": "class"
                  },
                  "class": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "actor",
                  "class"
                ]
              },
              {
                "properties": {
                  "type": {
                    "const": "hotlist"
                  },
                  "add": {
                    "$ref": "#/definitions/stringList"
                  },
                  "remove": {
                    "$ref": "#/definitions/stringList"
                  }
                },
                "required": [
                  "actor",
                  "add",
                  "remove"
                ]
              },
              {
                "properties": {
                  "type": {
                    "const": "equip"
                  },
                  "slot": {
                    "$ref": "#/definitions/gearSlot"
                  },
                  "item": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "actor",
                  "slot",
                  "item"
                ]
              },
              {
                "properties": {
                  "type": {
                    "const": "unequip"
                  },
                  "slot": {
                    "$ref": "#/definitions/gearSlot"
                  },
                  "item": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "actor",
                  "slot"
                ]
              },
              {
                "properties": {
                  "type": {
                    "const": "npc"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "action": {
                    "$ref": "#/definitions/npcAction"
                  },
                  "note": {
                    "type": "string"
                  },
                  "unlock": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "id",
                  "action"
                ]
              },
              {
                "properties": {
                  "type": {
                    "not": {
                      "enum": [
                        "system_message",
                        "achievement",
                        "loot",
                        "hp",
                        "level_up",
                        "rank",
                        "map_reveal",
                        "sponsor",
                        "chapter",
                        "status",
                        "inventory",
                        "note",
                        "skill",
                        "spell",
                        "class",
                        "hotlist",
                        "equip",
                        "unequip",
                        "npc"
                      ]
                    }
                  }
                }
              }
            ]
          }
        ]
      }
    }
  }
}
