{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dcc-watch-hub/contracts/npcs.schema.json",
  "title": "Registry (007 npc registry)",
  "type": "object",
  "required": [
    "entities"
  ],
  "additionalProperties": false,
  "definitions": {
    "fact": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "entity": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "intro",
        "facts"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "boss",
            "vendor",
            "ally"
          ]
        },
        "portrait": {
          "type": "string",
          "pattern": "^/.+$"
        },
        "floor": {
          "type": "integer",
          "minimum": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "intro": {
          "type": "string",
          "minLength": 1
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/fact"
          }
        }
      }
    }
  },
  "properties": {
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/entity"
      }
    }
  }
}
