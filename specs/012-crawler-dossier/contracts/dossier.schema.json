{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dcc-watch-hub/contracts/dossier.schema.json",
  "title": "Compiled crawler dossier (012)",
  "comment": "public/data/dossier/<id>.json, written by scripts/build-dossier.ts and gitignored. Exactly one card per AIRED episode, ascending: a card for an episode past its hubLiveAt never reaches this file, and no episode is ever missing one.",
  "type": "object",
  "required": ["id", "generatedAt", "updates"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "updates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "episode",
          "floor",
          "kind",
          "onCamera",
          "title",
          "body",
          "chips",
          "level",
          "condition"
        ],
        "additionalProperties": false,
        "properties": {
          "episode": { "type": "integer", "minimum": 1 },
          "floor": {
            "comment": "From show.json, never authored.",
            "type": "integer",
            "minimum": 1
          },
          "kind": { "enum": ["update", "quiet"] },
          "onCamera": { "type": "boolean" },
          "title": { "type": "string", "minLength": 1, "maxLength": 60 },
          "body": { "type": "string", "minLength": 1 },
          "chips": {
            "type": "array",
            "maxItems": 3,
            "items": { "type": "string", "minLength": 1 }
          },
          "level": {
            "comment": "Never null here: an authored null was filled from the reducer.",
            "type": "integer",
            "minimum": 1
          },
          "condition": { "enum": ["alive", "deceased"] }
        }
      }
    }
  }
}
