{
  "name": "dcc-watch-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Dungeon Crawl Cast Watch Hub — the System's broadcast feed",
  "engines": {
    "node": ">=20.9 <21 || >=22"
  },
  "scripts": {
    "predev": "tsx scripts/build-dossier.ts",
    "dev": "vite",
    "prebuild": "tsx scripts/build-dossier.ts",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist/server && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sheet-to-json": "tsx scripts/sheet-to-json.ts",
    "build:status": "tsx scripts/build-status.ts",
    "build:dossier": "tsx scripts/build-dossier.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20.17.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/youtube": "^0.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "csv-parse": "^5.6.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "puppeteer-core": "^23.11.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
